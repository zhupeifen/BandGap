# Virtual environments
.venv/
.venv_dl/

# Python
__pycache__/
*.pyc
*.pyo

# Large datasets (external — obtained separately, not tracked in git); small stored
# result files (data/*_results.json) ARE tracked so every table can be checked without rerunning
data/*
!data/*_results.json
data/*_R1_backup.json

# Trained model artifacts (regenerated by the scripts)
scripts/perovskite_fractions_model.json

# LaTeX build artifacts (manuscript.tex/.pdf are tracked; these are not)
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc

# OS / editor cruft
.DS_Store
Thumbs.db

# Manuscript / paper draft — kept local only, not on GitHub
manuscript/

# Submission packages and HPC access notes — local only
Submission_CompMatSci/
HPC_info.md

# local build scratch (LaTeX PDFs)
tmp/
